generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Procesador (CPU) ───────────────────────────────────────────────

model Cpu {
  id                       String   @id @default(cuid())
  nombre                   String
  marca                    String
  socket                   String
  tipoMemoria              String   // DDR4 | DDR5
  requiereCooler           Boolean
  tdp                      Int      // Watts
  tieneGraficosIntegrados  Boolean
  imagenUrl                String?
  moneda                   String   @default("USD") // USD | PEN
  precio                   Decimal? @db.Decimal(10, 2)
  stock                    Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([socket])
  @@index([tipoMemoria])
}

// ─── Placa Madre (Motherboard) ──────────────────────────────────────

model Motherboard {
  id            String   @id @default(cuid())
  nombre        String
  marca         String
  socket        String
  tipoMemoria   String   // DDR4 | DDR5
  factorForma   String   // ATX | Micro-ATX | Mini-ITX
  ramSlots      Int
  maxMemoriaGB  Int
  imagenUrl     String?
  moneda        String   @default("USD") // USD | PEN
  precio        Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([socket])
  @@index([tipoMemoria])
  @@index([factorForma])
}

// ─── Memoria RAM ────────────────────────────────────────────────────

model Ram {
  id             String   @id @default(cuid())
  nombre         String
  marca          String
  tipoMemoria    String   // DDR4 | DDR5
  factorForma    String   // DIMM | SODIMM
  capacidadGB    Int
  frecuenciaMHz  Int
  imagenUrl      String?
  moneda         String   @default("USD") // USD | PEN
  precio         Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipoMemoria])
  @@index([factorForma])
}

// ─── Tarjeta de Video (GPU) ─────────────────────────────────────────

model Gpu {
  id                              String   @id @default(cuid())
  nombre                          String
  marca                           String
  vramGB                          Int
  consumoRecomendadoFuenteWatts   Int
  largoMm                         Int
  imagenUrl                       String?
  moneda                          String   @default("USD") // USD | PEN
  precio                          Decimal? @db.Decimal(10, 2)
  stock                           Int      @default(0)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@index([marca])
}

// ─── Sistema de Refrigeración (Cooler / AIO) ────────────────────────

model Cooler {
  id                  String   @id @default(cuid())
  nombre              String
  marca               String
  socketsSoportados   String[] // e.g. ["LGA1700", "AM5", "LGA1851"]
  tdpSoportadoWatts   Int
  tipoRefrigeracion   String   // Aire | Líquida AIO
  numeroVentiladores  Int
  imagenUrl           String?
  moneda              String   @default("USD") // USD | PEN
  precio              Decimal? @db.Decimal(10, 2)
  stock               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tipoRefrigeracion])
}

// ─── Gabinete (Case) ────────────────────────────────────────────────

model Case {
  id                            String   @id @default(cuid())
  nombre                        String
  marca                         String
  soportaFactoresForma          String[] // e.g. ["ATX", "Micro-ATX", "Mini-ITX"]
  largoMaxGpuMm                 Int
  tieneFuentePoder              Boolean
  potenciaFuenteWatts           Int      // 0 si no incluye
  soportaFanCoolerVentiladores  Int      // max fans or radiator slots
  imagenUrl                     String?
  moneda                        String   @default("USD") // USD | PEN
  precio                        Decimal? @db.Decimal(10, 2)
  stock                         Int      @default(0)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([soportaFactoresForma])
}

// ─── Fuente de Poder (PSU) ──────────────────────────────────────────

model Psu {
  id                  String   @id @default(cuid())
  nombre              String
  marca               String
  potenciaWatts       Int
  certificacion80Plus String   // Bronze | Gold | Platinum | Titanium
  esModular           Boolean
  factorForma         String   // ATX | SFX
  imagenUrl           String?
  moneda              String   @default("USD") // USD | PEN
  precio              Decimal? @db.Decimal(10, 2)
  stock               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([certificacion80Plus])
  @@index([factorForma])
}

// ─── Cliente (tienda pública) ────────────────────────────────────────

model Cliente {
  id           String   @id @default(cuid())
  nombre       String
  correo       String   @unique
  telefono     String
  passwordHash String // bcrypt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([nombre])
}

// ─── Tipo de Cambio (USD/PEN) ────────────────────────────────────────

model TipoCambio {
  id          String   @id @default(cuid())
  compra      Decimal  @db.Decimal(10, 4) // Tipo de cambio de compra (USD → PEN)
  venta       Decimal  @db.Decimal(10, 4) // Tipo de cambio de venta (USD → PEN)
  fuente      String   @default("SUNAT")  // Fuente del tipo de cambio
  fecha       DateTime @default(now())    // Fecha del tipo de cambio
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fecha])
}
